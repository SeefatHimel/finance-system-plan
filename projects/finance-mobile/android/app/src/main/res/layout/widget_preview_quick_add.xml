<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="14dp"
  android:background="@drawable/finance_widget_background">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="@string/widget_quick_add_name" android:textColor="#E9F4F8"
    android:textSize="16sp" android:textStyle="bold" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:text="@string/widget_quick_add_description"
    android:textColor="#A3B7C3" android:textSize="12sp" />
</LinearLayout>
