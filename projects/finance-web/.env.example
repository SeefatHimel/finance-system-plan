NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_SERVER_API_BASE_URL=http://localhost:8000
# Production only: match the API secret; never use a NEXT_PUBLIC_ variable.
FINANCE_PROXY_AUTH_SECRET=
