FROM node:22-alpine AS build
WORKDIR /workspace/projects/finance-web
COPY projects/finance-web/package.json projects/finance-web/package-lock.json ./
RUN npm ci
COPY projects/finance-web ./
COPY projects/finance-contracts ../finance-contracts
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
RUN npm run build

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /workspace/projects/finance-web
COPY --from=build /workspace/projects/finance-web/package.json /workspace/projects/finance-web/package-lock.json ./
COPY --from=build /workspace/projects/finance-web/node_modules ./node_modules
COPY --chown=node:node --from=build /workspace/projects/finance-web/.next ./.next
COPY --from=build /workspace/projects/finance-web/next.config.mjs ./next.config.mjs
USER node
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0", "--port", "3000"]
